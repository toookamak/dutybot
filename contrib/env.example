# Copy to /etc/dutybot/env on the target host. Fill in locally; never commit secrets.
# At least one complete channel is required (Telegram token+chat, or Web user+password hash).

# BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
# ALLOWED_CHAT_ID=REPLACE_WITH_NUMERIC_CHAT_ID

# WEB_USER=REPLACE_WITH_LOCAL_USERNAME
# WEB_PASSWORD_HASH=REPLACE_WITH_PBKDF2_SHA256_HASH
WEB_BIND=127.0.0.1
WEB_PORT=8787
